{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rimmile",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/cloudflare",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": false
  },
  "observability": { "enabled": false }
}
